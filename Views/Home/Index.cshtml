@model List<MASH.Models.Movie>

@{
    ViewData["Title"] = "Home";
	var FavoriteIds = ViewBag.FavoriteIds as List<int> ?? new List<int>();
}

<div class="mash-home">

    <section class="hero-section">
        <div class="hero-content">
            <p class="hero-label">WELCOME TO MASH</p>
            <h1>Find something<br />worth watching.</h1>
            <p class="hero-description">
                Discover popular movies and keep track of what you watched.
            </p>
        </div>
    </section>

    <section class="movies-section">
        <div class="section-header">
            <div>
                <p class="section-label">TRENDING NOW</p>
                <h2>Popular Movies</h2>
            </div>
        </div>

        <div class="movie-grid">

            @foreach (var movie in Model)
            {
                <article class="movie-card">


                    <div class="movie-poster">
                        <img src="@($"https://image.tmdb.org/t/p/w500{movie.PosterPath}")"
                             alt="@movie.Title" />
                    </div>
                    @if (FavoriteIds.Contains(movie.Id))
                    {
                        <form asp-controller="Favorites" asp-action="Remove" method="post">
                            <input type="hidden" name="movieId" value="@movie.Id" />
                            <button type="submit" class="favorite-btn">
                                <img src="/Images/red heart.png" alt="Remove from favorites" />
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Favorites" asp-action="Add" method="post">
                            <input type="hidden" name="movieId" value="@movie.Id" />
                            <button type="submit" class="favorite-btn">
                                <img src="/Images/heart.png" alt="Add to favorites" />
                            </button>
                        </form>
                    }

                    <div class="movie-info">
							@if (FavoriteIds.Contains(movie.Id))
							{
								<form asp-controller="Favorites" asp-action="Remove" method="post">
                                <input type="hidden" name="movieId" value="@movie.Id"/>
                                <button type="submit" class="favorite-btn">
                                <img src="/Images/red heart.png" alt="Remove from favorites"/>
                                </button>  
                                </form>
							}
                        else
                        {
                                <form asp-controller="Favorites" asp-action="Add" method="post">
                                    <input type="hidden" name="movieId" value="@movie.Id" />
                                    <button type="submit" class="favorite-btn">
                                        <img src="/Images/heart.png" alt="Add to favorites" />
                                    </button>
                                </form>
                        }
                        
                        <h3>@movie.Title</h3>
                    </div>
                </article>
            }

        </div>
    </section>

</div>
